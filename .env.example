# =====================================================================
# Document Validation Agent - configuration
# Copy to .env and adjust. Defaults below target docker-compose service
# names (redis, mocks). For a local run without Docker use localhost.
# =====================================================================

# ---------- App ----------
APP_NAME=doc-validation-agent
LOG_LEVEL=INFO
WEBHOOK_SECRET=change-me-webhook-secret

# ---------- Queue / task store ----------
REDIS_URL=redis://redis:6379/0
TASK_TTL_SECONDS=604800
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT=300

# ---------- LLM (any OpenAI-compatible endpoint) ----------
# Real OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# Mock LLM:     LLM_BASE_URL=http://mocks:9000/v1        (no key needed)
LLM_BASE_URL=http://mocks:9000/v1
LLM_API_KEY=sk-mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
# Set false if your provider does not support response_format=json_object
LLM_JSON_MODE=true
LLM_MAX_TOOL_ROUNDS=4

# ---------- External services ----------
RAG_API_URL=http://mocks:9000
RAG_API_KEY=
HISTORY_API_URL=http://mocks:9000
HISTORY_API_KEY=
RESULT_API_URL=http://mocks:9000/results
RESULT_API_TOKEN=change-me-result-token
# Optional: status push on every status change. Empty = disabled.
STATUS_CALLBACK_URL=http://mocks:9000/status
HTTP_TIMEOUT=20
HTTP_MAX_RETRIES=3

# ---------- Matching ----------
# Fuzzy score >= this is accepted without an AI call
FUZZY_AUTO_ACCEPT=90
# Identifier fields: compared strictly (normalized), never "reasoned" by AI
STRICT_FIELDS=imei_or_serial,id_number,invoice_no
# Fields excluded from ocr_vs_user rows
EXCLUDED_FIELDS=confidence
# OCR confidence below this adds a flag and forces at least manual review
OCR_MIN_CONFIDENCE=0.6
# Customer model vs claimed invoice line: below this score the claim is flagged
ITEM_MODEL_MIN_SCORE=80

# ---------- Scoring & decision ----------
WEIGHT_FIELDS=0.5
WEIGHT_TC=0.3
WEIGHT_HISTORY=0.2
APPROVE_THRESHOLD=80
REJECT_THRESHOLD=50
# Overall score cap when a hard (high-risk) history flag exists
HARD_FLAG_SCORE_CAP=20
# What a high-severity TC failure (wrong device/retailer/period) leads to: reject | review
TC_HIGH_ISSUE_DECISION=reject

# ---------- History risk rules ----------
# Risk level per field that has previous claims: high = hard flag
RISK_RULES={"imei_or_serial":"high","imei":"high","serial":"high","invoice_no":"high","id_number":"medium"}
RISK_DEFAULT_LEVEL=low
# Penalty (from a 100 history score) per flagged field, by level
RISK_PENALTY_HIGH=100
RISK_PENALTY_MEDIUM=40
RISK_PENALTY_LOW=15

# ---------- Prompts ----------
# Prompts live in a versioned YAML file (see prompts/prompts.yaml).
# Relative paths resolve from the project root. Restart api + worker after editing.
PROMPTS_FILE=prompts/prompts.yaml
